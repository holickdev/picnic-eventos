---
import Layout from "@/layouts/Layout.astro";
import { Users, Sparkles } from "lucide-react";
import { packages } from "@/data/packages";
import { ImageGallery } from "@/components/ImageGallery";
import { PackageBookingCard } from "@/components/PackageBookingCard";

// Static paths generation - se ejecuta en build time
export async function getStaticPaths() {
    return packages.map((pkg) => ({
        params: { id: pkg.id },
        props: { pkg }, // Pasa el paquete como prop
    }));
}

const { pkg } = Astro.props;

// Metadata para SEO
const pageTitle = `${pkg.title} - Picnic Eventos`;
const pageDescription = `${pkg.description} ${pkg.capacity}. Precio: $${pkg.price} USD.`;
---

<Layout title={pageTitle} description={pageDescription}>
    <main class="min-h-screen bg-[var(--color-pearl)] pb-20">
        {/* Hero Section - Server-Side Rendered */}
        <section
            id={`hero-${pkg.id}`}
            class="relative h-[70dvh] md:h-[70vh] overflow-hidden bg-gradient-to-b from-black/40 via-transparent to-black/60"
        >
            {/* Image Gallery Component - Cliente */}
            <ImageGallery images={pkg.images} title={pkg.title} client:load />
        </section>

        <section
            id={`content-${pkg.id}`}
            class="max-w-7xl mx-auto flex flex-col gap-6 md:gap-12 px-5 md:px-12 py-12 md:py-20"
        >
            {/* Package Title Overlay - Server-Side */}
            <div class="">
                {
                    pkg.bestSeller && (
                        <span class="inline-block px-4 py-1.5 bg-white/95 text-[var(--color-dusty-rose)] rounded-full mb-4">
                            ✨ Best Seller
                        </span>
                    )
                }
                <div
                    class="text-gray-900 max-w-dvw flex flex-row sm:flex-row sm:justify-start sm:items-baseline gap-10"
                >
                    <h1
                        class="text-[clamp(2.5rem,6vw,5rem)] leading-[1.1] tracking-[-0.01em]"
                    >
                        {pkg.title}
                    </h1>
                    <div class="flex items-baseline gap-3 shrink-0">
                        <span class="text-4xl md:text-5xl lg:text-6xl"
                            >${pkg.price}</span
                        >
                        <span class="text-xl">USD</span>
                    </div>
                </div>
            </div>

            {/* Content Section - Server-Side */}
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                {/* Main Content */}
                <div class="lg:col-span-2">
                    {/* Capacity */}
                    <div
                        class="mb-8 p-6 bg-white rounded-3xl shadow-lg border border-[var(--color-dusty-rose)]/10 animate-fade-in-up"
                    >
                        <div class="flex items-center gap-3 mb-2">
                            <Users
                                className="w-6 h-6 text-[var(--color-dusty-rose)]"
                            />
                            <h3>Capacidad</h3>
                        </div>
                        <p class="text-[var(--color-graphite)]/70">
                            {pkg.capacity}
                        </p>
                    </div>

                    {/* What's Included */}
                    <div
                        class="bg-white rounded-3xl shadow-lg p-8 md:p-10 border border-[var(--color-dusty-rose)]/10 animate-fade-in-up"
                    >
                        <div class="flex items-center gap-3 mb-6">
                            <Sparkles
                                className="w-6 h-6 text-[var(--color-dusty-rose)]"
                            />
                            <h3>¿Qué Incluye?</h3>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            {
                                pkg.items.map((item) => (
                                    <div class="flex items-center gap-3 p-4 bg-[var(--color-soft-sand)]/30 rounded-2xl">
                                        <div class="w-2.5 h-2.5 rounded-full bg-[var(--color-dusty-rose)] flex-shrink-0" />
                                        <span class="text-[var(--color-graphite)]">
                                            {item}
                                        </span>
                                    </div>
                                ))
                            }
                        </div>
                    </div>

                    {/* Description */}
                    <div
                        class="mt-8 p-8 bg-gradient-to-br from-[var(--color-dusty-rose)]/5 to-[var(--color-dusty-rose)]/10 rounded-3xl border border-[var(--color-dusty-rose)]/10 animate-fade-in-up"
                    >
                        <h4 class="mb-3">Sobre este paquete</h4>
                        <p
                            class="text-[var(--color-graphite)]/70 leading-relaxed"
                        >
                            {pkg.description} Perfecto para crear momentos inolvidables
                            con todos los detalles cuidados para ti.
                        </p>
                    </div>
                </div>

                {/* Sidebar - Booking Card (Client Component) */}
                <div class="lg:col-span-1">
                    <PackageBookingCard
                        packageData={{
                            id: pkg.id,
                            title: pkg.title,
                            price: pkg.price,
                            capacity: pkg.capacity,
                        }}
                        client:load
                    />
                </div>
            </div>
        </section>
    </main>
</Layout>
