---
// src/pages/terminos.astro
import Layout from "@/layouts/Layout.astro";
import { ArrowLeft, FileText, AlertCircle } from "lucide-react";

const terms = [
    "Para apartar fecha se solicita un 50% del costo total del evento y el pago restante se realiza el día del evento.",
    "En caso de cancelación se pide que se haga mínimo 5 días antes, de lo contrario no se reembolsa anticipo.",
    "Aceptamos transferencias y efectivo como métodos de pago.",
    "Tiene un costo extra de transporte si tu evento está fuera de nuestra área de cobertura.",
    "Área de cobertura (Mariño y Maneiro).",
    "En caso de que algún artículo se extravíe o se encuentre en mal estado, se hará un cargo.",
    "Si el evento se realiza en la playa o espacio público lo más tarde que se puede dejar el mobiliario es a las 6 pm. De requerir más horas fuera de ese horario tendrá un costo adicional.",
    "Si el montaje requiere alguna maniobra extra (es decir, es en un 2do piso, no hay ascensor, caminar una distancia con el mobiliario etc.) se hará un cargo extra.",
    "No se pueden mojar los cojines, si se mojan los cojines se realizara un cargo extra.",
];
---

<Layout>
    <main class="min-h-screen bg-[var(--color-pearl)]">
        <!-- Hero Header -->
        <div
            class="relative bg-gradient-to-br from-[var(--color-dusty-rose)] to-[var(--color-champagne)] py-20 md:py-32 px-5 md:px-12"
        >
            <!-- Back Button -->
            <a
                href="/"
                class="absolute top-20 md:top-6 left-4 md:left-6 z-20 w-12 h-12 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center shadow-lg hover:bg-white transition-all animate-on-load animate-fade-in-left"
            >
                <ArrowLeft className="w-5 h-5 text-[var(--color-graphite)]" />
            </a>

            <div class="max-w-4xl mx-auto text-center">
                <div
                    class="inline-flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm text-white rounded-full mb-6 animate-on-load animate-fade-in-down animate-delay-200"
                >
                    <FileText className="w-4 h-4" />
                    <span>Legal</span>
                </div>

                <h1
                    class="text-white mb-4 animate-on-load animate-fade-in-up animate-delay-400"
                >
                    Términos y Condiciones
                </h1>

                <p
                    class="text-white/90 text-lg animate-on-load animate-fade-in-up animate-delay-600"
                >
                    Por favor, lee detenidamente nuestras políticas antes de
                    realizar tu reserva
                </p>
            </div>
        </div>

        <!-- Terms Content -->
        <div class="max-w-4xl mx-auto px-5 md:px-12 py-16 md:py-24">
            <div
                class="bg-white rounded-3xl shadow-2xl p-8 md:p-12 border border-[var(--color-dusty-rose)]/10 animate-on-load animate-scale-in animate-delay-800"
            >
                <div class="space-y-6">
                    {
                        terms.map((term, index) => (
                            <div
                                class="flex gap-4 p-5 rounded-2xl hover:bg-[var(--color-soft-sand)]/20 transition-colors animate-on-load animate-fade-in-left"
                                style={`animation-delay: ${0.9 + index * 0.05}s;`}
                            >
                                <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-gradient-rose text-[var(--color-dusty-rose)] rounded-full font-medium text-xl">
                                    {index + 1}
                                </div>
                                <p class="flex-1 text-[var(--color-graphite)]/80 leading-relaxed pt-2">
                                    {term}
                                </p>
                            </div>
                        ))
                    }
                </div>

                <!-- Important Notice -->
                <div
                    class="mt-10 p-6 md:p-8 bg-[var(--color-dusty-rose)]/5 border-2 border-[var(--color-dusty-rose)]/20 rounded-2xl flex gap-4 animate-on-load animate-fade-in-up animate-delay-1000"
                >
                    <AlertCircle
                        className="w-6 h-6 text-[var(--color-dusty-rose)] flex-shrink-0 mt-1"
                    />
                    <div>
                        <h4 class="text-[var(--color-dusty-rose)] mb-2">
                            Importante
                        </h4>
                        <p
                            class="text-[var(--color-graphite)]/70 leading-relaxed"
                        >
                            Al realizar tu reserva, confirmas que has leído y
                            aceptas estos términos y condiciones. Si tienes
                            alguna duda, no dudes en contactarnos antes de
                            confirmar tu pedido.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Contact CTA -->
            <div
                class="mt-12 text-center p-10 md:p-12 bg-white rounded-3xl shadow-2xl border border-[var(--color-dusty-rose)]/10 animate-on-load animate-fade-in-up animate-delay-1000"
            >
                <h3 class="mb-3">
                    ¿Tienes preguntas sobre nuestras políticas?
                </h3>
                <p class="text-[var(--color-graphite)]/70 mb-8">
                    Estamos aquí para aclarar todas tus dudas
                </p>
                <a
                    href="/faq"
                    class="inline-block px-8 py-4 bg-[var(--color-dusty-rose)] text-white rounded-full hover:bg-[var(--color-dusty-rose)]/80 transition-all shadow-lg hover:shadow-xl"
                >
                    Ver Preguntas Frecuentes
                </a>
            </div>
        </div>
    </main>
    <script>
        // Intersection Observer for scroll animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: "0px 0px -50px 0px",
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("in-view");
                }
            });
        }, observerOptions);

        // Observe all animate-on-load elements
        document.querySelectorAll(".animate-on-load").forEach((el) => {
            observer.observe(el);
        });
    </script>
</Layout>
