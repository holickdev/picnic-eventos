---
// src/components/Footer.astro
import { Instagram, Facebook, Mail, MapPin, Phone } from "lucide-react";

const socialLinks = [
    { icon: Instagram, href: "https://instagram.com", label: "Instagram" },
    { icon: Facebook, href: "https://facebook.com", label: "Facebook" },
    { icon: Mail, href: "mailto:info@picniceventosmgta.com", label: "Email" },
];

const footerLinks = [
    { title: "Paquetes" },
    { title: "Estaciones" },
    { title: "FAQ" },
    { title: "Términos" },
];
---

<footer
    class="relative bg-gradient-to-b from-transparent to-[var(--color-soft-sand)] pt-12 md:pt-20 pb-8 md:pb-12 overflow-hidden"
>
    <div class="max-w-[1600px] mx-auto px-5 md:px-6 lg:px-12">
        <!-- Main Footer Content -->
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12 mb-12 md:mb-16"
        >
            <!-- Brand Column -->
            <div class="lg:col-span-2 animate-on-load animate-fade-in-up">
                <h4 class="text-display mb-4">
                    Picnic <span class="text-[var(--color-dusty-rose)]"
                        >Eventos Mgta</span
                    >
                </h4>
                <p
                    class="text-[var(--color-graphite)]/70 mb-6 max-w-md leading-relaxed"
                >
                    Creamos experiencias de lujo personalizadas que transforman
                    tus momentos especiales en recuerdos inolvidables.
                </p>

                <!-- Contact Info -->
                <div class="space-y-3">
                    <div
                        class="flex items-center gap-3 text-[var(--color-graphite)]/70"
                    >
                        <MapPin
                            className="w-4 h-4 text-[var(--color-dusty-rose)]"
                        />
                        <span>Margarita Island, Venezuela</span>
                    </div>
                    <div
                        class="flex items-center gap-3 text-[var(--color-graphite)]/70"
                    >
                        <Phone
                            className="w-4 h-4 text-[var(--color-dusty-rose)]"
                        />
                        <span>+123 456 7890</span>
                    </div>
                    <div
                        class="flex items-center gap-3 text-[var(--color-graphite)]/70"
                    >
                        <Mail
                            className="w-4 h-4 text-[var(--color-dusty-rose)]"
                        />
                        <span>info@picniceventos.com</span>
                    </div>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="animate-on-load animate-fade-in-up animate-delay-200">
                <h4 class="mb-6">Enlaces Rápidos</h4>
                <ul class="space-y-3">
                    {
                        footerLinks.slice(0, 2).map((link) => (
                            <li>
                                <a
                                    href="#"
                                    class="text-[var(--color-graphite)]/70 hover:text-[var(--color-dusty-rose)] transition-colors"
                                >
                                    {link.title}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Legal Links -->
            <div class="animate-on-load animate-fade-in-up animate-delay-400">
                <h4 class="mb-6">Información</h4>
                <ul class="space-y-3">
                    {
                        footerLinks.slice(2).map((link) => (
                            <li>
                                <a
                                    href="#"
                                    class="text-[var(--color-graphite)]/70 hover:text-[var(--color-dusty-rose)] transition-colors"
                                >
                                    {link.title}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div
            class="flex flex-col md:flex-row justify-between items-center gap-6 pt-8 border-t border-[var(--color-graphite)]/10 animate-on-load animate-fade-in animate-delay-600"
        >
            <!-- Copyright -->
            <p class="text-sm text-[var(--color-graphite)]/60">
                © 2025 Picnic Eventos Mgta. Todos los derechos reservados.
            </p>

            <!-- Social Links -->
            <div class="flex gap-4">
                {
                    socialLinks.map((social) => {
                        const Icon = social.icon;
                        return (
                            <a
                                href={social.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={social.label}
                                class="w-10 h-10 rounded-full border-2 border-[var(--color-graphite)]/20 flex items-center justify-center hover:border-[var(--color-dusty-rose)] hover:bg-[var(--color-dusty-rose)] hover:text-white transition-all duration-300 group"
                            >
                                <Icon className="w-4 h-4" />
                            </a>
                        );
                    })
                }
            </div>
        </div>
    </div>

    <!-- Decorative background elements -->
    <div
        class="absolute bottom-0 left-0 w-64 h-64 bg-gradient-to-tr from-[var(--color-dusty-rose)]/5 to-transparent rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
        class="absolute top-0 right-0 w-96 h-96 bg-gradient-to-bl from-[var(--color-dusty-rose)]/5 to-transparent rounded-full blur-3xl pointer-events-none"
    >
    </div>
</footer>

<script>
    // Intersection Observer for scroll animations
    const observerOptions = {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add("in-view");
                entry.target.style.opacity = "1";
            }
        });
    }, observerOptions);

    // Observe all animate-on-load elements
    document.querySelectorAll(".animate-on-load").forEach((el) => {
        observer.observe(el);
    });
</script>
