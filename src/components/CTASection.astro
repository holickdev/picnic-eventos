---
// src/components/CTASection.astro
import { ArrowRight, Instagram, Mail, Phone } from "lucide-react";
---

<section class="relative py-12 md:py-20 lg:py-32 overflow-hidden">
    <div class="max-w-[1600px] mx-auto px-5 md:px-6 lg:px-12">
        <!-- Main CTA Card - Immersive with Glassmorphism -->
        <div
            class="relative rounded-[2rem_1rem_2rem_1rem] md:rounded-[4rem_2rem_4rem_2rem] overflow-hidden shadow-2xl animate-on-load animate-scale-in"
        >
            <!-- Background Image -->
            <div class="absolute inset-0">
                <img
                    src="/img/picnics/picnic-paquete-rubi-2.webp"
                    alt="Luxury outdoor event background"
                    class="w-full h-full object-cover md:object-[50%_70%]"
                />
                <!-- Dark overlay -->
                <div
                    class="absolute inset-0 bg-gradient-to-br from-black/70 via-black/60 to-black/80"
                >
                </div>
            </div>

            <!-- Content -->
            <div
                class="relative z-10 px-6 py-16 md:px-8 md:py-20 lg:px-20 lg:py-32"
            >
                <div class="max-w-4xl mx-auto text-center">
                    <div
                        class="animate-on-load animate-fade-in-up animate-delay-200"
                    >
                        <h2 class="text-display text-white mb-6 md:mb-8">
                            Crea Tu Historia
                        </h2>
                    </div>

                    <p
                        class="text-lg md:text-xl lg:text-2xl text-white/90 mb-10 md:mb-12 leading-relaxed max-w-2xl mx-auto animate-on-load animate-fade-in-up animate-delay-400"
                    >
                        Deja que transformemos tus momentos especiales en
                        experiencias extraordinarias que recordarás para siempre
                    </p>

                    <!-- Glassmorphism Button -->
                    <div
                        class="flex justify-center items-center animate-on-load animate-fade-in-up animate-delay-600"
                    >
                        <a
                            href="https://wa.me/584123588120?text=Hola!%20Me%20gustar%C3%ADa%20cotizar%20sus%20servicios"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group glass-morphism px-8 md:px-12 py-4 md:py-6 min-h-[48px] rounded-full hover:bg-white/60 transition-all duration-500 flex items-center justify-center gap-4"
                        >
                            <span
                                class="text-base md:text-lg text-white group-hover:text-[var(--color-graphite)] transition-colors"
                            >
                                Solicitar Cotización
                            </span>
                            <ArrowRight
                                className="w-5 h-5 text-white group-hover:text-[var(--color-graphite)] group-hover:translate-x-2 transition-all"
                            />
                        </a>
                    </div>

                    <!-- Contact Info -->
                    <div
                        class="mt-12 md:mt-16 flex flex-col sm:flex-row gap-6 md:gap-8 justify-center items-start sm:items-center text-white/80 text-sm md:text-base animate-on-load animate-fade-in-up animate-delay-800"
                    >
                        <a
                            href="https://wa.me/584123588120?text=Hola!%20Me%20gustar%C3%ADa%20cotizar%20sus%20servicios"
                            class="flex items-center gap-3 hover:text-white transition-colors group"
                        >
                            <div
                                class="w-10 h-10 rounded-full glass-morphism flex items-center justify-center group-hover:bg-white/40 transition-all"
                            >
                                <Phone className="w-4 h-4" />
                            </div>
                            <span>+58 412 3588120</span>
                        </a>

                        <a
                            href="mailto:sofidelaisla@gmail.com"
                            class="flex items-center gap-3 hover:text-white transition-colors group"
                        >
                            <div
                                class="w-10 h-10 rounded-full glass-morphism flex items-center justify-center group-hover:bg-white/40 transition-all"
                            >
                                <Mail className="w-4 h-4" />
                            </div>
                            <span>sofidelaisla@gmail.com</span>
                        </a>

                        <a
                            href="https://instagram.com/picniceventos_mgta"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center gap-3 hover:text-white transition-colors group"
                        >
                            <div
                                class="w-10 h-10 rounded-full glass-morphism flex items-center justify-center group-hover:bg-white/40 transition-all"
                            >
                                <Instagram className="w-4 h-4" />
                            </div>
                            <span>@picniceventosmgta</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Decorative floating elements -->
            <div
                class="absolute top-20 left-20 w-32 h-32 bg-[var(--color-dusty-rose)] opacity-20 rounded-full blur-3xl pointer-events-none animate-float"
            >
            </div>
            <div
                class="absolute bottom-20 right-20 w-40 h-40 bg-[var(--color-dusty-rose)] opacity-20 rounded-full blur-3xl pointer-events-none animate-float-rotate"
            >
            </div>
        </div>
    </div>
</section>

<script>
    // Intersection Observer for scroll animations
    const observerOptions = {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add("in-view");
                entry.target.style.opacity = "1";
            }
        });
    }, observerOptions);

    // Observe all animate-on-load elements
    document.querySelectorAll(".animate-on-load").forEach((el) => {
        observer.observe(el);
    });
</script>
