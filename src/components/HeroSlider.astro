---
// src/components/HeroSlider.astro
import { ChevronLeft, ChevronRight } from "lucide-react";

const heroSlides = [
    {
        image: "/img/picnics/picnic-romantico-1.webp",
        title: "MOMENTOS ROMÁNTICOS",
    },
    {
        image: "/img/picnics/picnic-arte.webp",
        title: "EXPERIENCIAS CREATIVAS",
    },
    {
        image: "/img/picnics/picnic-paquete-rubi-3.webp",
        title: "CELEBRACIONES ESPECIALES",
    },
];
---

<section class="relative w-full h-screen overflow-hidden">
    <!-- Slider Container -->
    <div class="absolute inset-0">
        {
            heroSlides.map((slide, index) => (
                <div
                    class={`hero-slide absolute inset-0 w-full h-full transition-opacity duration-800 ${index === 0 ? "opacity-100" : "opacity-0"}`}
                    data-slide-index={index}
                >
                    <img
                        src={slide.image}
                        alt={slide.title}
                        class="w-full h-full object-cover"
                        style="object-position: center 70%;"
                    />
                    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/40" />
                </div>
            ))
        }
    </div>

    <!-- Navigation Arrows -->
    <button
        id="prev-slide"
        class="z-20 absolute left-4 md:left-12 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-14 md:h-14 rounded-full glass-morphism flex items-center justify-center hover:bg-white/60 transition-all duration-300 group"
        aria-label="Previous slide"
    >
        <ChevronLeft
            className="w-5 h-5 md:w-6 md:h-6 text-[var(--color-graphite)] group-hover:-translate-x-1 transition-transform"
        />
    </button>

    <button
        id="next-slide"
        class="z-20 absolute right-4 md:right-12 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-14 md:h-14 rounded-full glass-morphism flex items-center justify-center hover:bg-white/60 transition-all duration-300 group"
        aria-label="Next slide"
    >
        <ChevronRight
            className="w-5 h-5 md:w-6 md:h-6 text-[var(--color-graphite)] group-hover:translate-x-1 transition-transform"
        />
    </button>

    <!-- Dots Indicator -->
    <div
        class="absolute bottom-8 md:bottom-8 left-1/2 -translate-x-1/2 z-10 flex gap-2"
        id="dots-container"
    >
        {
            heroSlides.map((_, index) => (
                <button
                    class={`dot h-1 rounded-full transition-all duration-300 ${
                        index === 0
                            ? "bg-[var(--color-dusty-rose)] w-8"
                            : "bg-white/40 w-8 hover:bg-white/60"
                    }`}
                    data-dot-index={index}
                    aria-label={`Go to slide ${index + 1}`}
                />
            ))
        }
    </div>

    <!-- Hero Content - Responsive Layout -->
    <div
        class="absolute inset-0 z-10 flex flex-col md:flex-row md:items-center md:justify-center px-5 md:px-12"
    >
        <div
            class="w-full max-w-5xl mx-auto text-center flex flex-col h-full md:h-auto justify-between md:justify-center"
        >
            <!-- Text Content Group (Top on mobile, centered on desktop) -->
            <div class="mt-20 md:mt-0">
                <!-- Brand Name -->
                <div
                    class="animate-on-load animate-fade-in-up animate-delay-400"
                >
                    <h1
                        class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl text-white select-none leading-tight mb-2 md:mb-4"
                        style="text-shadow: 2px 2px 20px rgba(0,0,0,0.5)"
                    >
                        Picnic Eventos:
                    </h1>
                </div>

                <!-- Dynamic Subtitle Container -->
                <div class="relative mb-6 md:mb-8">
                    {
                        heroSlides.map((slide, index) => (
                            <h2
                                class={`hero-title absolute inset-0 text-2xl sm:text-3xl md:text-5xl lg:text-6xl text-white select-none leading-tight transition-opacity duration-800 ${index === 0 ? "opacity-100" : "opacity-0"}`}
                                data-title-index={index}
                                style="text-shadow: 2px 2px 20px rgba(0,0,0)"
                            >
                                {slide.title}
                            </h2>
                        ))
                    }
                    <!-- Spacer to maintain layout height -->
                    <h2
                        class="text-2xl sm:text-3xl md:text-5xl lg:text-6xl text-transparent select-none leading-tight"
                        aria-hidden="true"
                    >
                        EXPERIENCIAS CREATIVAS
                    </h2>
                </div>
            </div>

            <!-- CTA Button (Bottom on mobile, centered on desktop) -->
            <div
                class="mb-20 md:mb-0 md:mt-8 animate-on-load animate-fade-in-up animate-delay-1000"
            >
                <a
                    href="#paquetes"
                    class="inline-flex items-center justify-center bg-[var(--color-dusty-rose)]/90 hover:bg-[var(--color-dusty-rose)] px-8 py-4 md:px-12 md:py-5 min-h-[48px] rounded-full transition-all duration-500 group shadow-xl"
                >
                    <span
                        class="text-sm md:text-lg tracking-wide text-white font-medium"
                    >
                        Explorar Ahora
                    </span>
                    <svg
                        class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</section>

<script>
    // Hero Slider functionality
    let currentSlide = 0;
    const slides = document.querySelectorAll(
        ".hero-slide",
    ) as NodeListOf<HTMLElement>;
    const dots = document.querySelectorAll(".dot") as NodeListOf<HTMLElement>;
    const totalSlides = slides.length;

    function showSlide(index: number) {
        // Hide all slides
        slides.forEach((slide) => {
            slide.style.opacity = "0";
        });

        // Show current slide
        if (slides[index]) {
            slides[index].style.opacity = "1";
        }

        // Update titles
        const titles = document.querySelectorAll(
            ".hero-title",
        ) as NodeListOf<HTMLElement>;
        titles.forEach((title, i) => {
            if (i === index) {
                title.style.opacity = "1";
            } else {
                title.style.opacity = "0";
            }
        });

        // Update dots
        dots.forEach((dot, i) => {
            if (i === index) {
                dot.classList.add("bg-[var(--color-dusty-rose)]", "w-8");
                dot.classList.remove("bg-white/40");
            } else {
                dot.classList.remove("bg-[var(--color-dusty-rose)]", "w-8");
                dot.classList.add("bg-white/40");
            }
        });

        currentSlide = index;
    }

    function nextSlide() {
        const next = (currentSlide + 1) % totalSlides;
        showSlide(next);
    }

    function prevSlide() {
        const prev = (currentSlide - 1 + totalSlides) % totalSlides;
        showSlide(prev);
    }

    // Auto-play slider
    let autoPlayInterval = setInterval(nextSlide, 5000);

    // Navigation buttons
    const prevBtn = document.getElementById("prev-slide");
    const nextBtn = document.getElementById("next-slide");

    if (prevBtn) {
        prevBtn.addEventListener("click", () => {
            prevSlide();
            // Restart auto-play
            clearInterval(autoPlayInterval);
            autoPlayInterval = setInterval(nextSlide, 5000);
        });
    }

    if (nextBtn) {
        nextBtn.addEventListener("click", () => {
            nextSlide();
            // Restart auto-play
            clearInterval(autoPlayInterval);
            autoPlayInterval = setInterval(nextSlide, 5000);
        });
    }

    // Dot navigation
    dots.forEach((dot, index) => {
        dot.addEventListener("click", () => {
            showSlide(index);
            // Restart auto-play
            clearInterval(autoPlayInterval);
            autoPlayInterval = setInterval(nextSlide, 5000);
        });
    });

    // Intersection Observer for scroll animations
    const observerOptions = {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add("in-view");
                (entry.target as HTMLElement).style.opacity = "1";
            }
        });
    }, observerOptions);

    // Observe all animate-on-load elements
    document.querySelectorAll(".animate-on-load").forEach((el) => {
        observer.observe(el);
    });
</script>

<style>
    .hero-slide {
        will-change: opacity;
    }

    .hero-title {
        will-change: opacity;
    }

    .dot {
        will-change: width, background-color;
    }
</style>
