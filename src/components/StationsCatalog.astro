---
// src/components/StationsCatalog.astro
import { Sparkles, ArrowRight } from "lucide-react";
import { StationCard } from "./StationCard";
import { stations } from "../data/packages";

interface Props {
    onNavigateToStation?: (stationId: string) => void;
    onAddToCart?: (stationId: string) => void;
}

const { onNavigateToStation, onAddToCart } = Astro.props;
---

<section
    id="estaciones"
    class="relative py-12 md:py-20 lg:py-32 overflow-hidden bg-gradient-to-b from-transparent to-[var(--color-soft-sand)]/20"
>
    <div class="max-w-[1600px] mx-auto px-5 md:px-6 lg:px-12 mb-12 md:mb-16">
        <div
            class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 md:gap-8"
        >
            <div class="flex-1 animate-on-load animate-fade-in-left">
                <div class="flex items-center gap-3 mb-4">
                    <Sparkles
                        className="w-5 h-5 md:w-6 md:h-6 text-[var(--color-dusty-rose)]"
                    />
                    <span
                        class="text-xs md:text-sm tracking-[0.2em] uppercase text-[var(--color-dusty-rose)]"
                    >
                        Personaliza tu Evento
                    </span>
                </div>
                <h2 class="text-display max-w-6xl">
                    Estaciones de Actividades
                </h2>
            </div>

            <div
                class="flex items-center gap-4 hidden md:flex animate-on-load animate-fade-in-right"
            >
                <button
                    id="scroll-left-stations"
                    class="w-12 h-12 rounded-full border-2 border-[var(--color-graphite)] flex items-center justify-center hover:bg-[var(--color-graphite)] hover:text-white transition-all duration-300 group"
                    aria-label="Scroll left"
                >
                    <ArrowRight className="w-5 h-5 rotate-180" />
                </button>
                <button
                    id="scroll-right-stations"
                    class="w-12 h-12 rounded-full border-2 border-[var(--color-graphite)] flex items-center justify-center hover:bg-[var(--color-graphite)] hover:text-white transition-all duration-300 group"
                    aria-label="Scroll right"
                >
                    <ArrowRight className="w-5 h-5" />
                </button>
            </div>
        </div>

        <p
            class="mt-4 md:mt-6 max-w-2xl text-base md:text-lg text-[var(--color-graphite)]/70 animate-on-load animate-fade-in-up animate-delay-200"
        >
            Añade estaciones especiales para hacer tu evento aún más memorable.
            Cada una incluye todo el material necesario.
        </p>
    </div>

    <!-- Horizontal Scrolling Cards -->
    <div class="relative">
        <div
            id="stations-scroll-container"
            class="flex flex-col md:flex-row gap-6 md:gap-8 px-5 md:px-6 lg:px-12 md:overflow-x-auto md:overflow-y-hidden scroll-smooth pb-8 scrollbar-hide"
            style="scrollbar-width: none; -ms-overflow-style: none;"
        >
            {
                stations.map((station) => (
                    <StationCard
                        key={station.id}
                        id={station.id}
                        title={station.title}
                        description={station.description}
                        images={station.images}
                        onNavigateToStation={onNavigateToStation}
                        onAddToCart={onAddToCart}
                        client:visible
                    />
                ))
            }
        </div>

        <!-- Gradient Fade Edges - Only on desktop -->
        <div
            class="absolute top-0 left-0 bottom-8 w-32 bg-gradient-to-r from-[var(--color-pearl)] to-transparent pointer-events-none hidden md:block"
        >
        </div>
        <div
            class="absolute top-0 right-0 bottom-8 w-32 bg-gradient-to-l from-[var(--color-pearl)] to-transparent pointer-events-none hidden md:block"
        >
        </div>
    </div>

    <!-- Floating decorative elements -->
    <div
        class="absolute bottom-20 left-20 w-32 h-32 bg-gradient-rose opacity-10 rounded-full blur-3xl pointer-events-none hidden lg:block animate-float-rotate"
    >
    </div>
</section>

<script>
    // Scroll functionality
    const scrollContainer = document.getElementById(
        "stations-scroll-container",
    );
    const scrollLeftBtn = document.getElementById("scroll-left-stations");
    const scrollRightBtn = document.getElementById("scroll-right-stations");

    function scroll(direction: "left" | "right") {
        if (scrollContainer) {
            const scrollAmount = 520;
            const newScrollLeft =
                scrollContainer.scrollLeft +
                (direction === "right" ? scrollAmount : -scrollAmount);
            scrollContainer.scrollTo({
                left: newScrollLeft,
                behavior: "smooth",
            });
        }
    }

    if (scrollLeftBtn) {
        scrollLeftBtn.addEventListener("click", () => scroll("left"));
    }

    if (scrollRightBtn) {
        scrollRightBtn.addEventListener("click", () => scroll("right"));
    }

    // Intersection Observer for scroll animations
    const observerOptions = {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add("in-view");
                (entry.target as HTMLElement).style.opacity = "1";
            }
        });
    }, observerOptions);

    // Observe all animate-on-load elements
    document.querySelectorAll(".animate-on-load").forEach((el) => {
        observer.observe(el);
    });
</script>

<style>
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }
</style>
